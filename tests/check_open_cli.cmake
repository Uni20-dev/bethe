set(precisions fp64 long-double)
if(FLOAT128)
  list(APPEND precisions fp128)
  check_cli(0 "Total energy: -1.6160254037844386467637231707529" 4 --precision fp128)
else()
  check_cli(1 "fp128 is unavailable" 4 --precision fp128)
endif()
foreach(precision IN LISTS precisions)
  check_cli(0 "Rapidities" 4 --precision ${precision} --roots --format plain)
  string(REGEX MATCHALL "-?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?" tokens "${output}")
  foreach(width IN ITEMS 132 35)
    set(ENV{COLUMNS} ${width})
    check_cli(0 "Rapidities" 4 --precision ${precision} --roots --format pretty)
    foreach(token IN LISTS tokens)
      string(FIND "${output}" "${token}" match)
      if(match EQUAL -1)
        message(FATAL_ERROR "Lost precision token '${token}'\n${output}")
      endif()
    endforeach()
  endforeach()
endforeach()
