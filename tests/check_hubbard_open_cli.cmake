if(output MATCHES "# index Lambda J|# index k I")
  message(FATAL_ERROR "Free standing waves have spurious Bethe labels")
endif()
check_cli(0 "exact free fermions" 5 --u -4 --particles 3 --sz 3/2 --max-iterations 0)
check_cli(0 "Total energy: 0" 1 --u 4)
check_cli(0 "Total energy: -4" 1 --u -4 --particles 2 --max-iterations 0)
check_cli(0 "Total energy: 0" 5 --u 4 --particles 0)
