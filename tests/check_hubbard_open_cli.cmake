include("${CMAKE_CURRENT_LIST_DIR}/check_cpu_time.cmake")
set(ENV{UNI20_COLOR} never)
set(ENV{UNI20_GLYPHS} ascii)
set(ENV{UNI20_CHARSET} escape)
set(ENV{COLUMNS} 200)
unset(ENV{NO_COLOR})
string(ASCII 27 escape)

function(check_cli expected_status expected_text)
  execute_process(COMMAND "${PROGRAM}" ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR "Unexpected status ${status} for ${ARGN}\n${output}\n${error}")
  endif()
  string(FIND "${output}${error}" "${expected_text}" match)
  if(match EQUAL -1)
    message(FATAL_ERROR "Missing '${expected_text}' for ${ARGN}\n${output}\n${error}")
  endif()
  if((expected_status EQUAL 0 OR expected_status EQUAL 2) AND NOT output MATCHES "^Usage:")
    normalize_cpu_time(output output)
    if(output MATCHES "Momentum|momentum index|periodic|Heisenberg|Multiplet|multiplets|scaled rapidity")
      message(FATAL_ERROR "Free-end Hubbard report contains periodic/spin-chain metadata\n${output}")
    endif()
  endif()
  set(output "${output}" PARENT_SCOPE)
endfunction()

check_cli(0 "Usage: bethe-hubbard-obc" --help)
check_cli(0 "Total energy: -0.828427124746" 2 --u 4)
set(default_output "${output}")
check_cli(0 "Precision: fp64" 2 --u 4 --particles 2 --sz 0 --precision fp64 --format plain)
if(NOT output STREQUAL default_output)
  message(FATAL_ERROR "OBC defaults differ from explicit half filling/Sz=0/fp64/plain")
endif()
check_cli(0 "Sz: 1/2" 5 --u 4)
set(odd_output "${output}")
check_cli(0 "Down spins: 2" 5 --u 4 --particles 5 --sz 1/2)
if(NOT output STREQUAL odd_output)
  message(FATAL_ERROR "Odd OBC default differs from explicit Sz=1/2")
endif()
check_cli(0 "Sz: 1/2" 6 --u 4 --particles 3)
check_cli(0 "Sz: 0" 5 --u 4 --particles 4)
check_cli(0 "Sz: -1/2" 5 --u -4 --particles 7 --sz -0.5 --roots)
check_cli(0 "Particles: 4" 6 --u 4 --particles 4)
check_cli(0 "Root particles: 5" 5 --u -4 --particles 4 --roots)
check_cli(0 "Energy offset: -8" 5 --u -4 --particles 4)
check_cli(0 "Root U: 4" 5 --u -4 --particles 4)
check_cli(0 "# Auxiliary-sector roots/occupations follow" 5 --u -4 --particles 4 --roots)
check_cli(0 "Auxiliary: Charge wave numbers" 5 --u -4 --particles 4 --roots --format pretty)
check_cli(0 "# index k I" 5 --u 4 --roots)
check_cli(0 "# index Lambda J" 5 --u 4 --roots)
check_cli(0 "Total energy: -4.828427124746" 2 --u -4)
check_cli(0 "Completed continuation stages: 4" 5 --u 1)
