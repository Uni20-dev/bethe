check_cli(0 "Energy offset: 8" 5 --u 4 --particles 7)
check_cli(2 "iteration limit reached; unconverged estimate" 5 --u 0.01 --max-iterations 0 --roots)
check_cli(2 "Iterations: 1" 5 --u 0.01 --max-iterations 1)
check_cli(2 "auxiliary sector" 5 --u -0.01 --particles 4 --max-iterations 1)
check_cli(2 "line search stalled; unconverged estimate" 6 --u 4 --tolerance 1e-30)
check_cli(0 "Hubbard (free ends) - sector ground state" 5 --u 4 --format pretty)
check_cli(1 "Usage:")
check_cli(1 "--u VALUE is required" 4)
foreach(option IN ITEMS --u --particles --sz --precision --tolerance --max-iterations --format)
  check_cli(1 "missing value" 4 ${option})
endforeach()
foreach(u IN ITEMS nan inf -inf)
  check_cli(1 "finite U" 4 --u ${u})
endforeach()
check_cli(1 "invalid real value" 4 --u 4junk)
check_cli(1 "out of range" 4 --u 1e-310)
check_cli(1 "1 <= sites" 0 --u 4)
check_cli(1 "invalid nonnegative integer" -1 --u 4)
check_cli(1 "invalid nonnegative integer" 4 --u 4 --particles -1)
check_cli(1 "invalid nonnegative integer" 4 --u 4 --max-iterations -1)
check_cli(1 "0 <= N <= 2L" 4 --u 4 --particles 9)
check_cli(1 "integer N_up and N_down" 4 --u 4 --sz -1/2)
check_cli(1 "integer N_up and N_down" 4 --u 4 --sz 3)
check_cli(1 "integer N_up and N_down" 5 --u 4 --sz 0)
check_cli(1 "parse failed" 4 --u 4 --sz 0.25)
foreach(option IN ITEMS --excitations --quantum-numbers --sectors --spin --boundary --boundary-field --momentum)
  check_cli(1 "unknown option: ${option}" 4 --u 4 ${option} 1)
endforeach()
check_cli(1 "unknown precision" 4 --u 4 --precision arbitrary)
check_cli(1 "unknown output format" 4 --u 4 --format arbitrary)
foreach(tol IN ITEMS 0 -1 nan inf)
  check_cli(1 "finite and positive" 4 --u 4 --tolerance ${tol})
endforeach()
set(precisions fp64 long-double)
if(FLOAT128)
  list(APPEND precisions fp128)
  check_cli(0 "Total energy: -0.82842712474619009760337744841" 2 --u 4 --precision fp128)
  check_cli(0 "U: -4.1234567890123456789012345678" 5 --u -4.12345678901234567890123456789 --precision fp128)
else()
  check_cli(1 "fp128 is unavailable" 4 --u 4 --precision fp128)
endif()
foreach(precision IN LISTS precisions)
  foreach(u IN ITEMS 0 4 -4)
    check_cli(0 "Total energy:" 5 --u ${u} --particles 4 --roots --precision ${precision} --format plain)
    set(plain "${output}")
    string(REGEX MATCHALL "-?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?" tokens "${output}")
    foreach(width IN ITEMS 200 35)
      set(ENV{COLUMNS} ${width})
      check_cli(0 "Hubbard (free ends)" 5 --u ${u} --particles 4 --roots --precision ${precision} --format pretty)
      foreach(token IN LISTS tokens)
        string(FIND "${output}" "${token}" match)
        if(match EQUAL -1)
          message(FATAL_ERROR "Lost numeric token '${token}' for ${precision}\n${output}")
        endif()
      endforeach()
    endforeach()
    set(ENV{UNI20_COLOR} always)
    check_cli(0 "Total energy:" 5 --u ${u} --particles 4 --roots --precision ${precision})
    if(NOT output STREQUAL plain)
      message(FATAL_ERROR "OBC piped auto output differs from plain")
    endif()
    check_cli(0 "${escape}[" 5 --u ${u} --particles 4 --roots --precision ${precision} --format pretty)
    set(ENV{UNI20_COLOR} never)
  endforeach()
endforeach()
set(ENV{UNI20_COLOR} auto)
set(ENV{NO_COLOR} 1)
check_cli(0 "Hubbard" 4 --u 4 --format pretty)
if(output MATCHES "${escape}")
  message(FATAL_ERROR "NO_COLOR left ANSI sequences")
endif()
