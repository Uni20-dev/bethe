  endif()
endforeach()
foreach(bethe_test IN LISTS @target@_LONG_RUNNING_TESTS)
  set_tests_properties("${bethe_test}" PROPERTIES
    ENVIRONMENT @environment_literal@ LABELS @long_labels_literal@
    TIMEOUT @long_timeout_literal@)
endforeach()
